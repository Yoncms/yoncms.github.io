# curl_cffi 同步实现的http请求类（单线程/同步执行）
# ====================================================================
class Curl(common):
    def __init__(self, proxy: Union[int, str] = 0):  
        super().__init__(proxy)           
        self.session = requests.Session(
            impersonate="chrome131", 
            headers=self.head, 
            timeout=30,
            curl_options=self.opt  
        )

    def query(self, url: str, ckey: Any = 0, **kw):
        session = self.session
        kw_copy = kw.copy()
        
        has_data = kw_copy.get("data") is not None or kw_copy.get("json") is not None
        method = session.post if has_data else session.get

        if kw_copy.get('data') == 1:
            del kw_copy['data']

        url = url if url.startswith('http') else f"{self.scheme}{self.host}/{url}"
        self.url404 = url

        requests_keys = {'url': url}
        if kw_copy:
            requests_keys.update(kw_copy)

        response = method(**requests_keys)
        # 直接调用父类 common 整合后的响应解析方法
        return self.process_response(response, ckey)


