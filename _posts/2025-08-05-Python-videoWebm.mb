# Python从视频里截取多段不连续的视频合并成一个视频<!--more-->

<pre>
import os
import subprocess
from concurrent.futures import ProcessPoolExecutor, as_completed

input_dir = "../index"
output_dir = "../temp"
os.makedirs(output_dir, exist_ok=True)

duration_cache = {}

def get_video_duration(filepath):
    try:
        result = subprocess.run(
            [
                "ffprobe", "-v", "error",
                "-select_streams", "v:0",
                "-show_entries", "format=duration",
                "-of", "default=noprint_wrappers=1:nokey=1",
                filepath
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True
        )
        return float(result.stdout.strip())
    except:
        return 0

def process_video(filename):
    input_path = os.path.join(input_dir, filename)
    name_no_ext = os.path.splitext(filename)[0]
    output_path = os.path.join(output_dir, f"{name_no_ext}.webm")

    duration = get_video_duration(input_path)
    if duration <= 0:
        return f"[跳过] 无法读取时长：{filename}"

    # 计算三个时间点
    t1 = 400
    t2 = duration / 2
    t3 = max(duration - 400, 0)

    # 如果t1,t2,t3超出范围，做剪裁防止负值和超过时长
    times = [max(min(t, duration - 1), 0) for t in [t1, t2, t3]]

    clip_files = [f"{output_dir}/{name_no_ext}_clip{i+1}.webm" for i in range(3)]
    concat_file = f"{output_dir}/{name_no_ext}_concat.txt"

    # 删除旧临时文件
    for f in clip_files + [concat_file]:
        if os.path.exists(f):
            os.remove(f)

    # 分段截取，每段1秒
    for i, start_time in enumerate(times):
        cmd = [
            "ffmpeg",
            "-y",
            "-ss", str(start_time),
            "-t", "1",
            "-i", input_path,
            "-c:v", "libvpx-vp9",
            "-b:v", "1M",
            "-an",
            clip_files[i]
        ]
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 生成 concat.txt 文件
    with open(concat_file, "w", encoding="utf-8") as f:
        for clip in clip_files:
            f.write(f"file '{os.path.abspath(clip)}'\n")

    # 合并片段
    cmd_concat = [
        "ffmpeg",
        "-y",
        "-f", "concat",
        "-safe", "0",
        "-i", concat_file,
        "-c", "copy",
        output_path
    ]
    subprocess.run(cmd_concat, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # 删除临时文件
    for f in clip_files + [concat_file]:
        if os.path.exists(f):
            os.remove(f)

    return f"[完成] {filename} 截取时间点: {times}"

def main():
    files = [f for f in os.listdir(input_dir) if f.lower().endswith(".mp4")]
    if not files:
        print("没有找到 mp4 文件")
        return

    max_workers = 4  # 视机器调整
    print(f"开始处理 {len(files)} 个视频，使用 {max_workers} 进程并发...")

    with ProcessPoolExecutor(max_workers=max_workers) as executor:
        futures = {executor.submit(process_video, f): f for f in files}
        for future in as_completed(futures):
            print(future.result())

    print("全部视频处理完成！")

if __name__ == "__main__":
    main()

</pre>