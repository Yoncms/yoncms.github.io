# 多并发
# curl_cffi Async 实现的http请求类
# 支持get和post请求、请求头、参数、代理
# ====================================================================
class ascurl(common):
    semaphore = asyncio.Semaphore(15)  # 根据需求调整
    def __init__(self, proxy: Union[int, str] = 0):
        super().__init__(proxy)

    async def __aenter__(self):
        # 初始化curl异步会话
        self.session = AsyncSession(
            impersonate="chrome131",
            max_clients=5,
            timeout=30,
            headers=self.head,  # 与自动指纹header合并
            cookies=self.cook,
            curl_options=self.opt
        )
        return self

    async def __aexit__(self, exc_type, exc_val, exc_tb):
        if self.session is not None:
            await self.session.close()
            await asyncio.sleep(0.1)

    async def query(self, url: str, ckey: Any = 0, **kw):
        """对外统一请求接口，完全兼容旧调用方式"""
        if not self.session:
            raise RuntimeError("请使用 async with ascurl() 上下文管理器")
        async with self.semaphore:
            retry_count = 0

            while retry_count < 3:
                try:
                    if kw.get('put')==1:
                        mtd = 'put'
                        del kw['put']
                    else:
                        mtd = None
                    req = self._build_request(url, **kw)
                    # async with self.semaphore:

                    response = await self._fetch(req, mtdx=mtd)
                    # 调用父类 common 提取整合的解析逻辑
                    return self.process_response(response, ckey)
                except (OSError, asyncio.TimeoutError, ConnectionResetError, RequestsError, CurlError) as e:
                    err_msg = str(e).lower()
                    if "timeout" in err_msg or "timed out" in err_msg or "超时" in err_msg:
                        retry_count += 1
                        print(f"🔴 queryErr: 超时，第{retry_count}次重试...")
                        await asyncio.sleep(1)
                    else:
                        raise
        raise Exception("🔴 重试3次后仍超时")

    def _build_request(self, url: str, **kw):
        """构建请求参数（纯同步）"""
        kw_copy = kw.copy()
        if not url.startswith('http'):
            url = f"{self.scheme}{self.host}/{url}"
        self.url404 = url
        # if 'study_details' in url: print(f"🔍 url404: {self.url404}")
        datajson = kw_copy.get('data') is not None or kw_copy.get('json') is not None
        if kw_copy.get('data') == 1:
            del kw_copy['data']
            
        method = 'POST' if datajson else 'GET'

        return {
            'method': method,
            'url': url,
            'kwargs': kw_copy
        }

    async def _fetch(self, req: Dict[str, Any], mtdx):
        # print(req['url'])
        """curl_cffi 发送请求，适配参数、超时"""
        method = req['method'].lower() if not mtdx else mtdx
        # if 'resource_learning_positions' in req['url']: print(method)
        method_func = getattr(self.session, method)
        resp = await method_func(
            req['url'],
            timeout=30,
            **req['kwargs'],
            allow_redirects=False
        )
        return resp

