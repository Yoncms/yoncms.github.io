import asyncio
import re
import json
from typing import Optional, Union, Dict, Any

from curl_cffi import AsyncSession, requests
from curl_cffi.const import CurlOpt
from curl_cffi.requests.errors import RequestsError, CurlError

class common:
    def __init__(self, proxy: Union[int, str] = 0):
        self.scheme = 'https://'
        self.host = ''
        self.head = {}
        self.cook = {}
        self.resp = 0
        # self.semaphore = asyncio.Semaphore(5)  # 限制并发数
        self.space = re.compile(r'[\n \s]+')
        self.session: Optional[Union[AsyncSession, requests.Session]] = None
        self.url404 = ""
        self.proxy = proxy
        self.opt = {}
        self.sethead()

    def sethead(self):
        self.head = {
            'accept': 'text/html,application/xhtml+xml,application/xml,application/json,application/signed-exchange,image/*',
            'accept-language': 'zh-CN,zh;q=0.9',
            'connection': 'keep-alive',
            'content-type':'application/json',
            # 告诉服务器支持gzip解压
            'accept-encoding': 'gzip, deflate, br', 
            # 在 requests 中，当发送 POST 但没有提供 data 或 json 参数时会自动处理。
            # 显式声明 Content-Type 避免触发服务器异常校验
            # 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',  # 表示提交表单，类似于ajax的post请求
            # 区分 AJAX 异步请求
            'X-Requested-With': 'XMLHttpRequest'
        }
        self.opt = {  # 关闭ssl校验
            CurlOpt.SSL_VERIFYPEER: 0,
            CurlOpt.SSL_VERIFYHOST: 0
        }
        if self.proxy != 0:
            self.opt[CurlOpt.PROXY] = "http://127.0.0.1:8080"
    
    def keyExists(self, dic, key):
        for k in key:
            if k in dic:
                return True
        return False

    # 动态更新会话header/cookie
    def upCH(self, **kw):
        if self.keyExitsts(kw, ('host', 'referer', 'authorization')):
            if self.session is None:
                self.head.update(kw)
            else:
                self.session.headers.update(kw)
            return

        # 更新cookie
        if self.session is None:
            self.cook.update(kw)
        else:
            self.session.cookies.update(kw)

    def getcooks(self, ckey: Any, response=None):
        # print(response.headers, dict(response.cookies))
        """【整合到common】统一从会话或响应对象中提取 Cookie"""
        if ckey == 0:
            return None

        cookies = response.cookies.get(ckey) or response.cookies
        return cookies

    # 判断返回的内容是否为图片
    def check_is_image(self, raw_bytes):
        IMAGE_MAGIC = {
            b'\xff\xd8\xff': 'jpeg',
            b'\x89PNG\r\n\x1a\n': 'png',
            b'GIF8': 'gif',
            b'BM': 'bmp',
        }
        for magic, fmt in IMAGE_MAGIC.items():
            if raw_bytes.startswith(magic):
                return fmt
        return None

    def redirect(self, response, ckey=0):
        if not response.ok:
            print("🔴 Err:", self.url404, response.status_code)
            return None
        # print(self.url404, response.status_code)
        if response.status_code in {301, 302, 303, 307, 308}:
            data = response.headers if ckey else response.headers.get("Location")
            return data

    def process_response(self, response, ckey=0):
        # print(self.url404, response.status_code)
        # print(f"[DEBUG] response.status_code: {getattr(response, 'status_code', 'N/A')}")
        # print(f"[DEBUG] response.headers: {getattr(response, 'headers', 'N/A')}")
        # print(f"[DEBUG] response.content length: {len(getattr(response, 'content', b''))}")
        if (ress:=response.status_code) >=400:
            # print(f'🔴 状态码异常: {ress}, 原始文本: {response.text[:200]}')
            return
        if resp:=self.redirect(response, ckey): return resp
            
        cookie = self.getcooks(ckey, response) if ckey else None
        content_type = response.headers.get("Content-Type", "").lower()
        try:
            if "json" in content_type:
                try:
                    data = response.json()
                except:
                    data = json.loads(re.search(r'\((.*)\)', response.text).group(1))
            elif "text" in content_type:
                raw = response.content
                if self.check_is_image(raw):
                    data = raw
                else:
                    data = self.space.sub("", response.text)

            else:
                data = response if self.resp else response.content

            return (data, cookie) if cookie is not None else data

        except Exception as e:
            print("🔴 process_responseErr >", e, self.url404)
            return None


